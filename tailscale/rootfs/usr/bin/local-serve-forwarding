#!/usr/bin/env bashio
# shellcheck shell=bash
# ==============================================================================
# Keep local connections to Tailscale Serve or Funnel out of host forwarding
# ==============================================================================

readonly RULE_COMMENT="tailscale-local-serve"

# Reconcile only our own exceptions, including old addresses and sharing ports.
function remove_exceptions() {
  local cmd="${1}"
  local rules rule address port
  local result=0
  local rule_pattern="^-A OUTPUT -d ([^[:space:]]+) -p tcp -m tcp --dport ([0-9]+) -m comment --comment \"?${RULE_COMMENT}\"? -j ACCEPT$"

  if ! rules="$(${cmd} -t nat -S OUTPUT)"; then
    bashio::log.warning "Unable to list local Serve forwarding exceptions (${cmd})"
    return 1
  fi

  while IFS= read -r rule; do
    if [[ "${rule}" =~ ${rule_pattern} ]]; then
      address="${BASH_REMATCH[1]}"
      port="${BASH_REMATCH[2]}"
      if ! ${cmd} -t nat -D OUTPUT -d "${address}" -p tcp --dport "${port}" \
        -m comment --comment "${RULE_COMMENT}" -j ACCEPT;
      then
        bashio::log.warning "Unable to remove local Serve forwarding exception (${cmd})"
        result=1
      fi
    fi
  done <<< "${rules}"

  return "${result}"
}

function setup_exception() {
  local cmd="${1}"
  local address="${2}"
  local port

  if ! remove_exceptions "${cmd}"; then
    return 1
  fi

  if ! bashio::var.has_value "${address}"; then
    return 0
  fi
  if ! bashio::config.equals 'share_homeassistant' 'serve' && \
    ! bashio::config.equals 'share_homeassistant' 'funnel';
  then
    return 0
  fi

  port="$(bashio::config 'share_on_port')"
  # Insert before any existing catch-all OUTPUT DNAT, including older versions.
  # ACCEPT stops NAT traversal; it does not bypass filter-table firewall rules.
  if ! ${cmd} -t nat -I OUTPUT 1 -d "${address}" -p tcp --dport "${port}" \
    -m comment --comment "${RULE_COMMENT}" -j ACCEPT;
  then
    bashio::log.warning "Unable to preserve local access to Serve on port ${port} (${cmd})"
    return 1
  fi
}

case "${1-}" in
  setup)
    case "${2-}" in
      iptables|ip6tables)
        setup_exception "${2}" "${3-}"
        ;;
      *)
        echo "Usage: $(basename "$0") setup iptables|ip6tables [address]" >&2
        exit 1
        ;;
    esac
    ;;
  remove)
    result=0
    remove_exceptions "iptables" || result=1
    remove_exceptions "ip6tables" || result=1
    exit "${result}"
    ;;
  *)
    echo "Usage: $(basename "$0") setup iptables|ip6tables [address] | remove" >&2
    exit 1
    ;;
esac
